{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://de-shorts/schema/quick-path.schema.json",
  "title": "QuickPath",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "title",
    "topic",
    "durationMin",
    "difficulty",
    "objective",
    "conceptIds",
    "quizConceptIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^path\\.(de|ai)\\.[a-z0-9-]+$"
    },
    "schemaVersion": { "type": "integer", "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "topic": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "durationMin": { "type": "integer", "minimum": 2, "maximum": 90 },
    "difficulty": {
      "type": "string",
      "enum": ["fundamental", "core", "intermediate", "advanced", "system-design"]
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 160 },
    "conceptIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "quizConceptIds": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
